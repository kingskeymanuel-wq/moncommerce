PORT=4000
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-secrete
DB_PATH=./db/moncommerce.db

# Fournisseur SMS (envoi du lien du ticket de caisse au client) — laissez vide en
# développement : les messages seront simplement journalisés dans la console au lieu d'être
# envoyés (voir lib/sms.js). Renseignez ces valeurs avec votre fournisseur
# réel (Africa's Talking, Orange SMS API, Twilio, Vonage...).
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=MonCommerce

# Mettez NODE_ENV=production en production : le code OTP n'est alors jamais
# renvoyé à l'interface, même sans fournisseur SMS.
NODE_ENV=development

# Origines autorisées (séparées par des virgules) si l'interface est servie
# depuis une autre adresse que ce serveur. Vide = toutes.
CORS_ORIGIN=

# Adresse publique du site (utilisée dans les liens envoyés aux clients et
# pour les retours de paiement CinetPay). Ex : https://www.maboutique.ci
PUBLIC_URL=

# Paiement en ligne CinetPay (Orange Money, MTN MoMo, Moov Money, Wave).
# Clé et mot de passe API de votre compte marchand (tableau de bord CinetPay).
# Clé « sk_test_… » = bac à sable (aucun débit réel) ; « sk_live_… » = production.
# Laissez vide pour désactiver le paiement en ligne.
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=

# Serveur e-mail (SMTP) : tickets de caisse par e-mail et campagnes marketing.
# Laissez vide en développement : les e-mails sont journalisés (« simulés »).
# Exemples : Brevo (smtp-relay.brevo.com, 587), Gmail (smtp.gmail.com, 465 + mot de passe d'application).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comptes créés automatiquement au démarrage s'ils n'existent pas (facultatif).
# Utile sur un hébergement sans disque persistant (Render gratuit) : les comptes
# sont recréés à chaque redémarrage. Mot de passe : 6 caractères minimum.
COMPTE_ADMIN_NOM=
COMPTE_ADMIN_TELEPHONE=
COMPTE_ADMIN_MOT_DE_PASSE=
COMPTE_VENDEUR_NOM=
COMPTE_VENDEUR_TELEPHONE=
COMPTE_VENDEUR_MOT_DE_PASSE=

# Protège la création du tout premier compte administrateur une fois en ligne.
CODE_INSTALLATION=
